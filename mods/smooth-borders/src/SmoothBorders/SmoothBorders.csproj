<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="$(OniCommon)oni-mod.props" />

  <PropertyGroup>
    <AssemblyName>SmoothBorders</AssemblyName>
    <RootNamespace>SmoothBorders</RootNamespace>
    <Version>0.1.0</Version>
    <UsePLib>true</UsePLib>
    <UseTranslations>true</UseTranslations>
    <ReferenceUnityUI>true</ReferenceUnityUI>
  </PropertyGroup>

  <ItemGroup>
    <!-- PLib options classes carry Newtonsoft attributes; the game ships Newtonsoft.Json. -->
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(GameLibsFolder)\Newtonsoft.Json.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Import Project="$(OniCommon)oni-mod.targets" />

</Project>
