<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="$(OniCommon)oni-mod.props" />

  <PropertyGroup>
    <AssemblyName>OvagroOverhead.Tests</AssemblyName>
    <RootNamespace>OvagroOverhead.Tests</RootNamespace>
    <!-- Never deployed as a mod; the TestRunner launcher copies the DLL into its run folder. -->
    <ModDeployFolder>none</ModDeployFolder>
    <!-- The side screen test clicks the planter screen's widgets through Unity's event system. -->
    <ReferenceUnityUI>true</ReferenceUnityUI>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\OvagroOverhead\OvagroOverhead.csproj" Private="false" />
    <ProjectReference Include="$(OniCommon)tools\TestRunner\TestRunner.csproj" Private="false" />
  </ItemGroup>

  <Import Project="$(OniCommon)oni-mod.targets" />

</Project>
