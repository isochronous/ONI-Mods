<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="$(MSBuildThisFileDirectory)..\..\common\oni-mod.props" />

  <PropertyGroup>
    <AssemblyName>UpgradePlanner</AssemblyName>
    <RootNamespace>UpgradePlanner</RootNamespace>
    <Version>0.5.0</Version>
    <UsePLib>true</UsePLib>
    <UseTranslations>true</UseTranslations>
    <ReferenceUnityUI>true</ReferenceUnityUI>
  </PropertyGroup>

  <!-- PLib with PDialog.Draggable (lib/PLib, see its README), by default; -p:PLibDll= -p:PLibDraggable=false
       builds with the NuGet PLib instead. -->
  <PropertyGroup>
    <PLibDll Condition="'$(PLibDll)' == ''">$(MSBuildThisFileDirectory)..\..\lib\PLib\PLib.dll</PLibDll>
    <PLibDraggable Condition="'$(PLibDraggable)' == ''">true</PLibDraggable>
  </PropertyGroup>
  <PropertyGroup Condition="'$(PLibDraggable)' == 'true'">
    <DefineConstants>$(DefineConstants);PLIB_DRAGGABLE</DefineConstants>
  </PropertyGroup>

  <!-- The game's own Newtonsoft, for the presets file. -->
  <ItemGroup>
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(GameLibsFolder)\Newtonsoft.Json.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Import Project="$(MSBuildThisFileDirectory)..\..\common\oni-mod.targets" />

</Project>
