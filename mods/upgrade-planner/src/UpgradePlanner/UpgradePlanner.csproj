<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="$(MSBuildThisFileDirectory)..\..\common\oni-mod.props" />

  <PropertyGroup>
    <AssemblyName>UpgradePlanner</AssemblyName>
    <RootNamespace>UpgradePlanner</RootNamespace>
    <Version>0.1.0</Version>
    <UsePLib>true</UsePLib>
    <ReferenceUnityUI>true</ReferenceUnityUI>
  </PropertyGroup>

  <!-- -p:PLibDraggable=true with a PLib that has PDialog.Draggable (see UpgradeDialog.Show). -->
  <PropertyGroup Condition="'$(PLibDraggable)' == 'true'">
    <DefineConstants>$(DefineConstants);PLIB_DRAGGABLE</DefineConstants>
  </PropertyGroup>

  <!-- The game's own Newtonsoft, for the presets file. -->
  <ItemGroup>
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(GameLibsFolder)\Newtonsoft.Json.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Import Project="$(MSBuildThisFileDirectory)..\..\common\oni-mod.targets" />

</Project>
