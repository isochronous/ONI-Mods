#. STRINGS.BITSHIFTER.DIAGNOSTICPANEL.ALL_OFF
msgctxt "STRINGS.BITSHIFTER.DIAGNOSTICPANEL.ALL_OFF"
msgid "All off"
msgstr "Выключить все"

#. STRINGS.BITSHIFTER.DIAGNOSTICPANEL.ALL_OFF_TOOLTIP
msgctxt "STRINGS.BITSHIFTER.DIAGNOSTICPANEL.ALL_OFF_TOOLTIP"
msgid "Switch every bit off"
msgstr "Выключить все биты"

#. STRINGS.BITSHIFTER.DIAGNOSTICPANEL.BITS_NONE
msgctxt "STRINGS.BITSHIFTER.DIAGNOSTICPANEL.BITS_NONE"
msgid "none"
msgstr "нет"

#. STRINGS.BITSHIFTER.DIAGNOSTICPANEL.BITS_RANGE
msgctxt "STRINGS.BITSHIFTER.DIAGNOSTICPANEL.BITS_RANGE"
msgid "{0}-{1}"
msgstr "{0}-{1}"

#. STRINGS.BITSHIFTER.DIAGNOSTICPANEL.BITS_SEPARATOR
msgctxt "STRINGS.BITSHIFTER.DIAGNOSTICPANEL.BITS_SEPARATOR"
msgid ", "
msgstr ", "

#. STRINGS.BITSHIFTER.DIAGNOSTICPANEL.CELL_INPUT
msgctxt "STRINGS.BITSHIFTER.DIAGNOSTICPANEL.CELL_INPUT"
msgid "The input has bit {0} on."
msgstr "На входе включён бит {0}."

#. STRINGS.BITSHIFTER.DIAGNOSTICPANEL.CELL_OFF
msgctxt "STRINGS.BITSHIFTER.DIAGNOSTICPANEL.CELL_OFF"
msgid "Bit {0}: switched off. Click to switch it on."
msgstr "Бит {0}: выключен. Нажмите, чтобы включить."

#. STRINGS.BITSHIFTER.DIAGNOSTICPANEL.CELL_ON
msgctxt "STRINGS.BITSHIFTER.DIAGNOSTICPANEL.CELL_ON"
msgid "Bit {0}: switched on. Click to switch it off."
msgstr "Бит {0}: включён. Нажмите, чтобы выключить."

#. STRINGS.BITSHIFTER.DIAGNOSTICPANEL.CELL_UNWIRED
msgctxt "STRINGS.BITSHIFTER.DIAGNOSTICPANEL.CELL_UNWIRED"
msgid "Bit {0}. Wire the output port to use the switches."
msgstr "Бит {0}. Подключите выходной порт, чтобы пользоваться выключателями."

#. STRINGS.BITSHIFTER.DIAGNOSTICPANEL.SIDE_SCREEN_TITLE
msgctxt "STRINGS.BITSHIFTER.DIAGNOSTICPANEL.SIDE_SCREEN_TITLE"
msgid "Switches"
msgstr "Выключатели"

#. STRINGS.BITSHIFTER.DIAGNOSTICPANEL.SIDE_SCREEN_UNWIRED
msgctxt "STRINGS.BITSHIFTER.DIAGNOSTICPANEL.SIDE_SCREEN_UNWIRED"
msgid "Wire the output port to use the switches."
msgstr "Подключите выходной порт, чтобы пользоваться выключателями."

#. STRINGS.BITSHIFTER.DIAGNOSTICPANEL.SIDE_SCREEN_WIRED
msgctxt "STRINGS.BITSHIFTER.DIAGNOSTICPANEL.SIDE_SCREEN_WIRED"
msgid "Switched bits join the input on the output."
msgstr "Включённые биты добавляются к входу на выходе."

#. STRINGS.BITSHIFTER.DIAGNOSTICPANEL.STATUS_INPUT
msgctxt "STRINGS.BITSHIFTER.DIAGNOSTICPANEL.STATUS_INPUT"
msgid "Input: {0}"
msgstr "Вход: {0}"

#. STRINGS.BITSHIFTER.DIAGNOSTICPANEL.STATUS_INPUT_TOOLTIP
msgctxt "STRINGS.BITSHIFTER.DIAGNOSTICPANEL.STATUS_INPUT_TOOLTIP"
msgid "Bits on the input ribbon carrying a <b><style=\"logic_on\">Green Signal</style></b>\nRibbon value: {1}"
msgstr "Биты входной ленты, несущие <b><style=\"logic_on\">Зеленый сигнал</style></b>\nЗначение ленты: {1}"

#. STRINGS.BITSHIFTER.DIAGNOSTICPANEL.STATUS_SWITCHES
msgctxt "STRINGS.BITSHIFTER.DIAGNOSTICPANEL.STATUS_SWITCHES"
msgid "Switches: {0}"
msgstr "Выключатели: {0}"

#. STRINGS.BITSHIFTER.DIAGNOSTICPANEL.STATUS_SWITCHES_TOOLTIP
msgctxt "STRINGS.BITSHIFTER.DIAGNOSTICPANEL.STATUS_SWITCHES_TOOLTIP"
msgid "Bits switched on in the side screen. The output carries these and every input bit."
msgstr "Биты, включённые на боковой панели. Выход передаёт их и все биты входа."

#. STRINGS.BITSHIFTER.FANOUTGATE.SIDE_SCREEN_TITLE
msgctxt "STRINGS.BITSHIFTER.FANOUTGATE.SIDE_SCREEN_TITLE"
msgid "Bits to send"
msgstr "Биты для отправки"

#. STRINGS.BUILDINGS.PREFABS.FANOUTGATE.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.FANOUTGATE.DESC"
msgid "One signal can switch many bits of a ribbon at once."
msgstr "Один сигнал может переключить сразу много битов ленты."

#. STRINGS.BUILDINGS.PREFABS.FANOUTGATE.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.FANOUTGATE.EFFECT"
msgid "Sends the bits chosen in its side screen on an <link=\"LOGICRIBBON\">Automation Ribbon</link> while its input receives a <b><style=\"logic_on\">Green Signal</style></b>.\n\nWhile the input receives a <b><style=\"logic_off\">Red Signal</style></b>, every bit of the ribbon carries a <b><style=\"logic_off\">Red Signal</style></b>."
msgstr "Пока на вход поступает <b><style=\"logic_on\">Зеленый сигнал</style></b>, подаёт на <link=\"LOGICRIBBON\">автоматическую ленту</link> биты, выбранные на боковой панели.\n\nПока на вход поступает <b><style=\"logic_off\">Красный сигнал</style></b>, каждый бит ленты несёт <b><style=\"logic_off\">Красный сигнал</style></b>."

#. STRINGS.BUILDINGS.PREFABS.FANOUTGATE.LOGIC_PORT
msgctxt "STRINGS.BUILDINGS.PREFABS.FANOUTGATE.LOGIC_PORT"
msgid "Input"
msgstr "Вход"

#. STRINGS.BUILDINGS.PREFABS.FANOUTGATE.LOGIC_PORT_ACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.FANOUTGATE.LOGIC_PORT_ACTIVE"
msgid "<b><style=\"logic_on\">Green Signal</style></b>: send the chosen bits"
msgstr "<b><style=\"logic_on\">Зеленый сигнал</style></b>: подаёт выбранные биты"

#. STRINGS.BUILDINGS.PREFABS.FANOUTGATE.LOGIC_PORT_INACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.FANOUTGATE.LOGIC_PORT_INACTIVE"
msgid "<b><style=\"logic_off\">Red Signal</style></b>: send a <b><style=\"logic_off\">Red Signal</style></b> on every bit"
msgstr "<b><style=\"logic_off\">Красный сигнал</style></b>: подаёт <b><style=\"logic_off\">Красный сигнал</style></b> на каждый бит"

#. STRINGS.BUILDINGS.PREFABS.FANOUTGATE.LOGIC_PORT_OUTPUT
msgctxt "STRINGS.BUILDINGS.PREFABS.FANOUTGATE.LOGIC_PORT_OUTPUT"
msgid "Ribbon Output"
msgstr "Выход ленты"

#. STRINGS.BUILDINGS.PREFABS.FANOUTGATE.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.FANOUTGATE.NAME"
msgid "<link=\"FANOUTGATE\">Fan-out Gate</link>"
msgstr "<link=\"FANOUTGATE\">Вентиль-разветвитель</link>"

#. STRINGS.BUILDINGS.PREFABS.FANOUTGATE.OUTPUT_PORT_ACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.FANOUTGATE.OUTPUT_PORT_ACTIVE"
msgid "Sends a <b><style=\"logic_on\">Green Signal</style></b> on each chosen bit while the input receives a <b><style=\"logic_on\">Green Signal</style></b>"
msgstr "Подаёт <b><style=\"logic_on\">Зеленый сигнал</style></b> на каждый выбранный бит, пока на вход поступает <b><style=\"logic_on\">Зеленый сигнал</style></b>"

#. STRINGS.BUILDINGS.PREFABS.FANOUTGATE.OUTPUT_PORT_INACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.FANOUTGATE.OUTPUT_PORT_INACTIVE"
msgid "Otherwise, sends a <b><style=\"logic_off\">Red Signal</style></b> on that bit"
msgstr "Иначе подаёт <b><style=\"logic_off\">Красный сигнал</style></b> на этот бит"

#. STRINGS.BUILDINGS.PREFABS.RIBBONDIAGNOSTICPANEL.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.RIBBONDIAGNOSTICPANEL.DESC"
msgid "Seeing every bit of a ribbon at once makes a circuit quick to trace."
msgstr "Когда видны сразу все биты ленты, схему легко проследить."

#. STRINGS.BUILDINGS.PREFABS.RIBBONDIAGNOSTICPANEL.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.RIBBONDIAGNOSTICPANEL.EFFECT"
msgid "Shows all 31 bits of an <link=\"LOGICRIBBON\">Automation Ribbon</link> on a grid of lamps: a lamp lights green for each bit carrying a <b><style=\"logic_on\">Green Signal</style></b> and red for each bit carrying a <b><style=\"logic_off\">Red Signal</style></b>.\n\nWith its output wired, it is also a 31-channel switch. Bits switched on light purple, and the output carries every bit that is on at the input or switched on."
msgstr "Показывает все 31 бит <link=\"LOGICRIBBON\">автоматической ленты</link> на сетке ламп: лампа горит зелёным для каждого бита, несущего <b><style=\"logic_on\">Зеленый сигнал</style></b>, и красным для каждого бита, несущего <b><style=\"logic_off\">Красный сигнал</style></b>.\n\nС подключённым выходом панель служит и 31-канальным выключателем. Включённые биты горят фиолетовым, а выход передаёт каждый бит, включённый на входе или выключателем."

#. STRINGS.BUILDINGS.PREFABS.RIBBONDIAGNOSTICPANEL.LOGIC_PORT
msgctxt "STRINGS.BUILDINGS.PREFABS.RIBBONDIAGNOSTICPANEL.LOGIC_PORT"
msgid "Ribbon Input"
msgstr "Вход ленты"

#. STRINGS.BUILDINGS.PREFABS.RIBBONDIAGNOSTICPANEL.LOGIC_PORT_ACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.RIBBONDIAGNOSTICPANEL.LOGIC_PORT_ACTIVE"
msgid "Lights a green lamp for each bit carrying a <b><style=\"logic_on\">Green Signal</style></b>"
msgstr "Зажигает зелёную лампу для каждого бита, несущего <b><style=\"logic_on\">Зеленый сигнал</style></b>"

#. STRINGS.BUILDINGS.PREFABS.RIBBONDIAGNOSTICPANEL.LOGIC_PORT_INACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.RIBBONDIAGNOSTICPANEL.LOGIC_PORT_INACTIVE"
msgid "Lights a red lamp for each bit carrying a <b><style=\"logic_off\">Red Signal</style></b>"
msgstr "Зажигает красную лампу для каждого бита, несущего <b><style=\"logic_off\">Красный сигнал</style></b>"

#. STRINGS.BUILDINGS.PREFABS.RIBBONDIAGNOSTICPANEL.LOGIC_PORT_OUTPUT
msgctxt "STRINGS.BUILDINGS.PREFABS.RIBBONDIAGNOSTICPANEL.LOGIC_PORT_OUTPUT"
msgid "Ribbon Output"
msgstr "Выход ленты"

#. STRINGS.BUILDINGS.PREFABS.RIBBONDIAGNOSTICPANEL.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.RIBBONDIAGNOSTICPANEL.NAME"
msgid "<link=\"RIBBONDIAGNOSTICPANEL\">Ribbon Diagnostic Panel</link>"
msgstr "<link=\"RIBBONDIAGNOSTICPANEL\">Диагностическая панель ленты</link>"

#. STRINGS.BUILDINGS.PREFABS.RIBBONDIAGNOSTICPANEL.OUTPUT_PORT_ACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.RIBBONDIAGNOSTICPANEL.OUTPUT_PORT_ACTIVE"
msgid "Sends a <b><style=\"logic_on\">Green Signal</style></b> on each bit that is on at the input or switched on"
msgstr "Подаёт <b><style=\"logic_on\">Зеленый сигнал</style></b> на каждый бит, включённый на входе или выключателем"

#. STRINGS.BUILDINGS.PREFABS.RIBBONDIAGNOSTICPANEL.OUTPUT_PORT_INACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.RIBBONDIAGNOSTICPANEL.OUTPUT_PORT_INACTIVE"
msgid "Otherwise, sends a <b><style=\"logic_off\">Red Signal</style></b> on that bit"
msgstr "Иначе подаёт <b><style=\"logic_off\">Красный сигнал</style></b> на этот бит"
