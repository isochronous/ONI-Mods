<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="$(OniCommon)oni-mod.props" />

  <PropertyGroup>
    <AssemblyName>StoragePodRedux</AssemblyName>
    <RootNamespace>StoragePodRedux</RootNamespace>
    <Version>1.1.0</Version>
    <UsePLib>true</UsePLib>
    <UseTranslations>true</UseTranslations>
  </PropertyGroup>

  <ItemGroup>
    <!-- Reading another mod's JSON config; the game ships Newtonsoft.Json. -->
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(GameLibsFolder)\Newtonsoft.Json.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Import Project="$(OniCommon)oni-mod.targets" />

</Project>
