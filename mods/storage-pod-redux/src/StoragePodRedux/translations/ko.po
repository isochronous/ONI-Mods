msgstr "활성화"

#. STRINGS.STORAGEPODREDUX.OPTIONS.COOL_POD_MODE.ENABLED.TOOLTIP
msgctxt "STRINGS.STORAGEPODREDUX.OPTIONS.COOL_POD_MODE.ENABLED.TOOLTIP"
msgid "Always add the Cool Pod."
msgstr "냉장 포드를 항상 추가합니다."

#. STRINGS.STORAGEPODREDUX.OPTIONS.STORAGE_POD_CAPACITY.NAME
msgctxt "STRINGS.STORAGEPODREDUX.OPTIONS.STORAGE_POD_CAPACITY.NAME"
msgid "Capacity (kg)"
msgstr "용량(kg)"

#. STRINGS.STORAGEPODREDUX.OPTIONS.STORAGE_POD_CAPACITY.TOOLTIP
msgctxt "STRINGS.STORAGEPODREDUX.OPTIONS.STORAGE_POD_CAPACITY.TOOLTIP"
msgid "How much the Storage Pod holds."
msgstr "보관 포드에 보관할 수 있는 양입니다."

#. STRINGS.STORAGEPODREDUX.OPTIONS.STORAGE_POD_ENABLED.NAME
msgctxt "STRINGS.STORAGEPODREDUX.OPTIONS.STORAGE_POD_ENABLED.NAME"
msgid "Storage Pod"
msgstr "보관 포드"

#. STRINGS.STORAGEPODREDUX.OPTIONS.STORAGE_POD_ENABLED.TOOLTIP
msgctxt "STRINGS.STORAGEPODREDUX.OPTIONS.STORAGE_POD_ENABLED.TOOLTIP"
msgid "Add the Storage Pod building. Takes effect after a restart."
msgstr "보관 포드 건조물을 추가합니다. 게임을 다시 시작한 뒤 적용됩니다."

#. STRINGS.STORAGEPODREDUX.OPTIONS.STORAGE_POD_STORES_FOOD.NAME
msgctxt "STRINGS.STORAGEPODREDUX.OPTIONS.STORAGE_POD_STORES_FOOD.NAME"
msgid "Stores food"
msgstr "식품 보관"

#. STRINGS.STORAGEPODREDUX.OPTIONS.STORAGE_POD_STORES_FOOD.TOOLTIP
msgctxt "STRINGS.STORAGEPODREDUX.OPTIONS.STORAGE_POD_STORES_FOOD.TOOLTIP"
msgid "Let the Storage Pod hold food as well as other solids. It is not refrigerated."
msgstr "보관 포드에 다른 고체와 함께 식품도 보관할 수 있게 합니다. 냉장되지는 않습니다."
