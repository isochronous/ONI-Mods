<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="$(OniCommon)oni-mod.props" />

  <PropertyGroup>
    <AssemblyName>StoragePodRedux.Tests</AssemblyName>
    <RootNamespace>StoragePodRedux.Tests</RootNamespace>
    <!-- Never deployed as a mod; the TestRunner launcher copies the DLL into its run folder. -->
    <ModDeployFolder>none</ModDeployFolder>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(GameLibsFolder)\Newtonsoft.Json.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <ProjectReference Include="..\StoragePodRedux\StoragePodRedux.csproj" Private="false" />
    <ProjectReference Include="$(OniCommon)tools\TestRunner\TestRunner.csproj" Private="false" />
  </ItemGroup>

  <Import Project="$(OniCommon)oni-mod.targets" />

</Project>
